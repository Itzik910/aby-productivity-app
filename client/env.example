# API Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Analytics
REACT_APP_GA_TRACKING_ID=your-google-analytics-id

# Feature Flags
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_LOCATION_FEATURES=true
REACT_APP_ENABLE_SOCIAL_FEATURES=true

# App Configuration
REACT_APP_APP_NAME=ABY Productivity
REACT_APP_APP_VERSION=1.0.0
REACT_APP_APP_DESCRIPTION=Smart task assistant with AI-powered suggestions

# External Services
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
REACT_APP_WEATHER_API_KEY=your-weather-api-key

# Development
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info 